# Rendered by the nginx image at startup; ${APP_DOMAIN} is substituted, nginx's own $variables are left alone.

upstream rails {
    server web:3001;
}

# Plain HTTP only redirects to HTTPS
server {
    listen 80;
    server_name ${APP_DOMAIN} *.${APP_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN} *.${APP_DOMAIN};

    # One wildcard certificate covers the apex and every tenant subdomain
    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # Resumes, brochures and profile pictures are uploaded through Rails
    client_max_body_size 20m;

    root /usr/share/nginx/html;

    # Shared proxy settings. Host must be passed through untouched: Rails reads the
    # tenant from the subdomain (5.example.com -> company 5).
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # API and Active Storage file links
    location ~ ^/(api|rails)/ {
        proxy_pass http://rails;
    }

    # /login and /signup are React pages on GET but Devise endpoints on POST/PATCH/DELETE
    location ~ ^/(login|logout|signup)(/|$) {
        if ($request_method = GET) {
            rewrite ^ /index.html last;
        }
        proxy_pass http://rails;
    }

    # Hashed build assets never change, so let browsers cache them for a long time
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Everything else is a React Router route
    location / {
        try_files $uri /index.html;
    }
}
