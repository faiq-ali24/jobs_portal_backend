# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored: never commit it.

# --- Domain ---
APP_DOMAIN=example.com
TLD_LENGTH=1

# --- Rails ---
RAILS_ENV=production
# Generate each with: openssl rand -hex 64
SECRET_KEY_BASE=
DEVISE_JWT_SECRET_KEY=
FORCE_SSL=true

# --- Postgres (container) ---
POSTGRES_USER=jobs_portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs_portal_production
# Must match the three values above
DATABASE_URL=postgres://jobs_portal:change-me@db:5432/jobs_portal_production

# --- Redis / Sidekiq ---
REDIS_URL=redis://redis:6379/0

# --- S3 uploads (credentials come from the EC2 instance role, not from here) ---
AWS_REGION=us-east-1
S3_BUCKET=

# --- Optional: email via Amazon SES SMTP. Leave SMTP_ADDRESS empty to disable sending. ---
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
